      "registryDependencies": [
        "button",
        "input",
        "separator",
        "sheet",
        "skeleton",
        "tooltip",
        "use-mobile"
      ],
      "files": [
        {
          "path": "registry/ui/sidebar.tsx",
          "type": "registry:ui",
          "target": "hoogin/ui/sidebar.tsx"
        }
      ],
      "type": "registry:ui"
    }
  ]
}